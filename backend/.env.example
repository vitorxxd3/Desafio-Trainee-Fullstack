
# ==========================================
# BANCO DE DADOS - PostgreSQL
# ==========================================
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/analisador_documentos?schema=public"

# ==========================================
# SERVIDOR
# ==========================================
PORT=3001

# ==========================================
# AUTENTICAÇÃO JWT
# ==========================================
JWT_SECRET="substitua_por_uma_chave_aleatoria_longa"

# ==========================================
# ANALISADOR DE DOCUMENTOS
# Opções: regras ou gemini
# ==========================================
ANALISADOR=regras

# ==========================================
# GOOGLE GEMINI - Opcional
# Necessário apenas se ANALISADOR=gemini
# ==========================================
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.1-flash-lite
